{
  "authors": [
    {
      "name": "noga-ng",
      "email": "nogagerma122@gmail.com"
    }
  ],

  "require": {
    "php": ">=8.1",
    "psr/cache": "^3.0",
    "psr/container": "^2.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0"
  },

  "autoload": {
    "psr-4": {
      "NCache\\": "Src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "NCache\\Tests\\": "Tests/"
    }
  },

  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^10.0",
    "ukko/phpredis-phpdoc": "5.0.1-beta8@beta"
  },

  "minimum-stability": "stable",
  "prefer-stable": true,

  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },

  "scripts": {
    "phpunit": "phpunit",
    "analyse":"./vendor/phpstan/phpstan/phpstan analyse",
    "dump": "composer dump-autoload -o"
  }
}
