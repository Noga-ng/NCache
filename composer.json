{
  "name": "noga-ng/ncache",
  "description": "A multiple drivers cache.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/Noga-ng/NCache",
  "authors": [
    {
      "name": "noga-ng",
      "email": "nogagerma122@gmail.com"
    }
  ],

  "require": {
    "php": ">=8.1",
    "ext-memcached": "*"
  },

  "autoload": {
    "psr-4": {
      "NCache\\": "Src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "NCache\\Tests\\": "Tests/"
    }
  },

  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^10.0",
    "ukko/phpredis-phpdoc": "5.0.1-beta8@beta"
  },

  "minimum-stability": "stable",
  "prefer-stable": true,

  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },

  "scripts": {
    "phpunit": "phpunit",
    "analyse":"phpstan analyse",
    "dump": "composer dump-autoload -o"
  }
}
