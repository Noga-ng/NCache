{
  "admin": {
    "cachePath": "./cache",
    "defaultDriver": "ARRAY_PHP",
    "namespace": "admin",
    "extensions": {
      "SERIALIZE": "nc",
      "STRING": "txt"
    },
    "defaultTtl": "days(2)",
    "drivers": {
      "redis": {
        "host": "127.0.0.1",
        "port": 6379,
        "timeout": 0,
        "password": null,
        "database":0
      },
      "memcached": {
        "host": "127.0.0.1",
        "port": 11211,
        "weight": 0
      }
    }
  },
  "users":{
    "cachePath":"./cache",
    "defaultDriver":"ARRAY_PHP",
    "defaultTtl":"days(2)",
    "namespace":"users"
  }
}